# The real annual reports used for Phase 12 validation. They are the
# publishers' documents, so the bytes stay local; the folder's README records
# where to get each one, and run_all.py stays tracked so anyone can reproduce
# the validation once they have downloaded them.
tests/fixtures/real/*.pdf

# Local-only regression snapshot of the real reports above (T1.0).
.snapshots/

# XBRL eval harness (T1.1): downloaded filings, rendered PDFs, companyfacts
# JSON, and per-run results. Only baseline_*.json results are committed.
evals/.cache/
evals/results/latest_*.json

# Local git worktrees; never part of the repository.
.claude/worktrees/
